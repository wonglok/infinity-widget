{
  "name": "infinity-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n webpack,serve \"npm run dev:webpack\" \"npm run dev:next\" ",
    "dev:next": "next dev --webpack --port 3001",
    "dev:webpack": "webpack -w --config webpack.config.cjs --mode development;",
    "build:next": "next build --webpack",
    "build:webpack": "webpack --config ./webpack.config.cjs --mode production;",
    "build": "npm run build:next; npm run build:webpack",
    "start": "next start"
  },
  "dependencies": {
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "next": "16.2.11",
    "postcss-loader": "^8.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-manifest-plugin": "^6.0.1",
    "worker-loader": "^3.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
